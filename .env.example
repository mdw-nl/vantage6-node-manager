# Environment variables for Vantage6 Node Manager

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production

# Optional: seed the first admin account on first run (only used if no
# users.yaml exists yet - once it exists, these are ignored on restart)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: override where the users file is stored
# USERS_FILE=/custom/path/to/users.yaml

# Optional: Custom vantage6 configuration directory
# VANTAGE6_CONFIG_DIR=/custom/path/to/config

# Optional: Custom data directory
# DATA_DIR=/custom/path/to/data
