# Environment variables for Vantage6 Node Manager

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production

# Optional: seed the first admin account on first run (only used if no
# users.yaml exists yet - once it exists, these are ignored on restart)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: override where the users file is stored
# USERS_FILE=/custom/path/to/users.yaml

# Optional: Custom vantage6 configuration directory
# VANTAGE6_CONFIG_DIR=/custom/path/to/config

# Optional: Custom vantage6 system configuration directory
# VANTAGE6_SYSTEM_CONFIG_DIR=/custom/path/to/system-config

# Optional: Custom data directory
# VANTAGE6_DATA_DIR=/custom/path/to/data

# Optional: override where the node ownership file is stored
# NODE_OWNERS_FILE=/custom/path/to/node_owners.yaml

# Optional: override where the audit log is written
# AUDIT_LOG_FILE=/custom/path/to/audit.log

# Optional: override the default node image (registry + tag) offered when
# creating/starting a node - see the "Node Docker Image" section in README.md
# NODE_IMAGE_REGISTRY=ghcr.io/mdw-nl/vantage6/infrastructure/node-lite
# NODE_IMAGE_TAG=4.14.0-rc8
